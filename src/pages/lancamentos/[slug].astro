---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BandcampPlayer from '../../components/BandcampPlayer.astro';
import ReleaseCard from '../../components/ReleaseCard.astro';
import { getReleases, resolveArtists, formatDate, type Release } from '../../lib/data';

export async function getStaticPaths() {
  const releases = await getReleases();
  return releases.map((r) => ({ params: { slug: r.id }, props: { release: r, all: releases } }));
}
const { release, all } = Astro.props as { release: Release; all: Release[] };
const d = release.data;
const artists = await resolveArtists(d.artists);
const { Content } = await render(release);
const ids = new Set(d.artists.map((a) => a.id));
const more = all.filter((r) => r.id !== release.id && r.data.artists.some((a) => ids.has(a.id))).slice(0, 4);
---
<Base title={`${d.title} — ${d.artist_line}`} description={`${d.format} de ${d.artist_line}, editado pela Biruta Records em ${formatDate(d.date)}.`}>
  <article class="release">
    <div class="art">
      <Image src={d.cover} alt={`Capa de ${d.title}`} width={700} height={700} loading="eager" />
      <BandcampPlayer id={d.bandcamp_id} type={d.bandcamp_type} url={d.bandcamp_url} title={d.title} tracks={d.tracks.length} />
    </div>
    <div class="info">
      <p class="eyebrow">{d.format}{d.catalog && ` · ${d.catalog}`}</p>
      <h1>{d.title}</h1>
      <p class="by">
        {artists.map((a, i) => (<>{i > 0 && ' & '}<a href={`/artistas/${a.id}`}>{a.data.name}</a></>))}
      </p>
      <p class="muted">Editado a {formatDate(d.date)}</p>
      {d.bandcamp_url && <p><a class="btn" href={d.bandcamp_url} rel="noopener">Ouvir e comprar no Bandcamp ↗</a></p>}

      {d.tracks.length > 1 && (
        <section class="tracks">
          <h2 class="eyebrow">Alinhamento</h2>
          <ol>{d.tracks.map((t) => <li><span>{t.title}</span><span class="muted">{t.duration}</span></li>)}</ol>
        </section>
      )}

      <div class="prose"><Content /></div>

      {d.credits && (
        <section class="credits">
          <h2 class="eyebrow">Créditos</h2>
          <p class="pre-line small">{d.credits}</p>
        </section>
      )}
    </div>
  </article>

  {more.length > 0 && (
    <section class="section">
      <div class="section-head"><h2>Mais de {d.artist_line}</h2></div>
      <div class="grid">{more.map((r) => <ReleaseCard release={r} />)}</div>
    </section>
  )}
</Base>

<style>
  .release { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 2.5rem; margin-bottom: 3rem; }
  .art { display: flex; flex-direction: column; gap: 1rem; position: sticky; top: 4rem; align-self: start; }
  .art img { width: 100%; aspect-ratio: 1; object-fit: cover; }
  .by { font-size: 1.25rem; font-weight: 700; margin-bottom: .25rem; }
  .by a { color: var(--ink); }
  .tracks ol { margin: 0 0 1.5rem; padding-left: 1.5rem; }
  .tracks li { padding: .3rem 0; border-bottom: 1px solid var(--line); }
  .tracks li { display: list-item; }
  .tracks li span:last-child { float: right; font-variant-numeric: tabular-nums; }
  .credits { margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  h2.eyebrow { font-size: .8rem; font-weight: 700; margin-top: 1.5rem; }
  @media (max-width: 760px) { .release { grid-template-columns: 1fr; } .art { position: static; } }
</style>
