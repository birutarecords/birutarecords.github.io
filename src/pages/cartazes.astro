---
import Base from '../layouts/Base.astro';
import PosterCard from '../components/PosterCard.astro';
import { getEvents, groupByYear } from '../lib/data';
const { upcoming, past } = await getEvents();
const all = [...upcoming.slice().reverse(), ...past];
---
<Base title="Cartazes" description="Arquivo de cartazes de concertos e festas da Biruta Records.">
  <h1>Cartazes</h1>
  <p class="muted">Arquivo visual de concertos, festas e apresentações.</p>
  {groupByYear(all).map(([y, evs]) => (
    <section class="section">
      <div class="section-head"><h2>{y}</h2></div>
      <div class="posters">{evs.map((e) => <PosterCard event={e} />)}</div>
    </section>
  ))}
</Base>
<style>
  .posters { display: grid; gap: 1.5rem 1.25rem; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
</style>
